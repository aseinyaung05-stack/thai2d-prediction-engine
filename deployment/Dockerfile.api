# ============================================================================
# Thai 2D API — Node/Express + Prisma (multi-stage, monorepo context)
# Compiles TypeScript at build time; runtime uses plain node (low memory).
# Build from REPO ROOT:  docker build -f deployment/Dockerfile.api -t thai2d-api .
# ============================================================================

FROM node:20-alpine AS deps
WORKDIR /app
# Workspaces: install everything from the root lockfile/manifests
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm install --no-audit --no-fund

FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY apps/api ./apps/api
COPY packages/shared ./packages/shared
COPY database ./database
# Prisma client + compile shared, then compile the API (plain-JS output)
RUN cd apps/api && npx prisma generate --schema ../../database/prisma/schema.prisma
RUN npm run build:shared && npm run build:api

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
# node_modules includes the workspace symlink @thai2d/shared -> packages/shared
# (source + compiled dist are copied below so the symlink resolves).
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/database ./database
WORKDIR /app/apps/api
# Render injects PORT; config reads process.env.PORT.
EXPOSE 4000
CMD ["node", "dist/apps/api/src/index.js"]

# ============================================================================
# Thai 2D Prediction Engine — environment template
# Copy to .env and fill values. NEVER commit real secrets.
# ============================================================================

# ---------------------------------------------------------------- database ---
# PostgreSQL (Supabase, Railway, local docker-compose, ...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thai2d?schema=public"
# Direct read-only connection used by the Python prediction service.
PREDICTION_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/thai2d"

# ------------------------------------------------------------------- modes ---
# development | production. In production the MOCK provider is rejected.
NODE_ENV=development
# Allow the MockDataProvider (clearly marked MOCK records). Never enable in prod.
ALLOW_MOCK_DATA=true
# When true, the engine refuses to serve predictions if data validation fails.
STRICT_DATA_VALIDATION=true

# ------------------------------------------------------------- data source ---
# active: thai2d | set | mock
DATA_PROVIDER=thai2d
# Official docs: https://docs.thaistock2d.com  (/live, /2d_result, /2d_history, /history)
THAI2D_API_BASE_URL=https://api.thaistock2d.com
# Optional — the public API works without a key today; set one if issued.
THAI2D_API_KEY=
# Official SET data (authoritative when a licensed key exists). Leave empty to
# disable the SET provider; the app then uses thai2d only.
SET_API_BASE_URL=https://data-api.set.or.th
SET_API_KEY=

# ------------------------------------------------------------------- sync ---
SYNC_INTERVAL_MINUTES=10
HTTP_TIMEOUT_MS=12000
HTTP_MAX_RETRIES=3

# -------------------------------------------------------- prediction svc ----
PREDICTION_SERVICE_URL=http://localhost:8000
PREDICTION_API_TOKEN=change-me-internal-token
# Walk-forward split sizes (fractions of chronological history)
WF_TRAIN_FRACTION=0.60
WF_VALIDATION_FRACTION=0.20
# Multicollinearity control
FEATURE_CORRELATION_THRESHOLD=0.90
# Retraining schedule (cron, server local time = UTC)
RETRAIN_CRON=15 18 * * *

# ------------------------------------------------------------- web app ------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PREDICTION_URL=http://localhost:8000

# ------------------------------------------------------------- security -----
# Basic-auth credentials protecting admin endpoints (sync/import/edit).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- timezone ---
# Canonical IANA zones (do not change unless you know why).
TZ_THAILAND=Asia/Bangkok
TZ_MYANMAR=Asia/Yangon
